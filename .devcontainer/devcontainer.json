// BJJ Éire — Dev Container (Java 25 Spring Boot + React SPA + MongoDB)
// Docs: https://containers.dev/implementors/json_reference/
{
    "name": "BJJ Éire Development Environment",
    "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "none",
            "installMaven": "true",
            "mavenVersion": "latest",
            "installGradle": "false"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24",
            "nodeGypDependencies": true
        },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": false,
            "upgradePackages": true
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "remoteUser": "vscode",
    "mounts": [
        "source=bjjeire-m2-cache,target=/home/vscode/.m2,type=volume"
    ],

    "postCreateCommand": "bash .devcontainer/post-create-commands.sh",

    "remoteEnv": {
        "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
        "MAVEN_OPTS": "-XX:+UseParallelGC -Dmaven.artifact.threads=8",
        "SPRING_OUTPUT_ANSI_ENABLED": "ALWAYS"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vscjava.vscode-spring-boot-dashboard",
                "vscjava.vscode-spring-initializr",
                "redhat.vscode-xml",

                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "bradlc.vscode-tailwindcss",
                "vitest.explorer",

                "mongodb.mongodb-vscode",
                "redhat.vscode-yaml",
                "github.vscode-github-actions",

                "EditorConfig.EditorConfig",
                "github.vscode-pull-request-github",
                "usernamehw.errorlens",
                "streetsidesoftware.code-spell-checker",
                "christian-kohler.path-intellisense"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.eslint": "explicit"
                },
                "eslint.workingDirectories": [
                    "src/bjjeire-app"
                ],

                "java.configuration.updateBuildConfiguration": "automatic",
                "java.compile.nullAnalysis.mode": "automatic",

                "java.jdt.ls.java.home": "/usr/lib/jvm/msopenjdk-current",
                // Formatting is enforced by Spotless + palantir-java-format (`./mvnw spotless:apply`),
                // so disable the built-in Eclipse formatter to avoid conflicting reformats.
                "java.format.enabled": false,
                "maven.executable.preferMavenWrapper": true
            }
        }
    },

    // Spring Boot (8080 direct / 5003 via compose), Vite dev server, web, Mongo, JVM debug.
    "forwardPorts": [8080, 5003, 3000, 5173, 60743, 27017, 5005],
    "portsAttributes": {
        "8080":  { "label": "Spring Boot API (direct)", "onAutoForward": "notify" },
        "5003":  { "label": "API (docker compose)",     "onAutoForward": "notify" },
        "3000":  { "label": "Web (docker compose)",     "onAutoForward": "notify" },
        "5173":  { "label": "Vite dev server",          "onAutoForward": "openBrowser" },
        "60743": { "label": "Frontend (HTTPS dev)",     "onAutoForward": "silent" },
        "27017": { "label": "MongoDB",                  "onAutoForward": "silent" },
        "5005":  { "label": "JVM remote debug",         "onAutoForward": "silent" }
    }
}
