{
  "name": "bjjworld-app",
  "private": true,
  "version": "0.1.35",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix --max-warnings 0",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:pact": "vitest run --project pact",
    "test:watch": "vitest --project unit --project integration",
    "test:ui": "vitest --ui --project unit --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "prepare": "husky",
    "test:integration": "vitest run --project integration",
    "gen:api-types": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript http://localhost:5003/openapi/v1.json -o src/types/generated/api.ts",
    "gen:api-types:ci": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript ./openapi-v1.json -o src/types/generated/api.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.{js,jsx,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.1",
    "@azure/msal-react": "^5.7.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
