{
  "name": "bjjworld-app",
  "private": true,
  "version": "0.1.45",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json}",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --fix --max-warnings 0",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:pact": "vitest run --project pact",
    "test:watch": "vitest --project unit --project integration",
    "test:ui": "vitest --ui --project unit --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "prepare": "husky",
    "test:integration": "vitest run --project integration",
    "gen:api-types": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript http://localhost:5003/openapi/v1.json -o src/types/generated/api.ts",
    "gen:api-types:ci": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript ./openapi-v1.json -o src/types/generated/api.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.{js,jsx,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@pact-foundation/pact": "^17.1.4",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/babel__core": "^7.20.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.7",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "^1.64.1",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  }
}
