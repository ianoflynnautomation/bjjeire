# Template for src/bjjeire-app/.env (or .env.local), read by the Vite dev server: npm run dev.
# Both files are gitignored. Every VITE_APP_* value ships to the browser: no secrets here (ADR-0006).
# The Docker image does not read this file; it takes the build arguments from the repository-root .env.

# --- Dev server and API proxy ---------------------------------------------------------------------
# vite.config.ts refuses to start in development without one of the SERVICES_API_* targets.
PORT=5173
# The local Docker API, published on loopback by docker-compose.override.java-local.yml.
SERVICES_API_HTTP_0=http://127.0.0.1:5003
# Leave blank locally: when set it wins over SERVICES_API_HTTP_0.
SERVICES_API_HTTPS_0=
# Blank: the SPA calls /api on its own origin and the dev server proxies it.
VITE_APP_API_URL=

VITE_APP_APP_URL=http://localhost:5173
VITE_APP_ENABLE_API_MOCKING=false
VITE_APP_APP_MOCK_API_PORT=443
VITE_APP_PAGE_SIZE=20
VITE_APP_PAGE_NUMBER=1

# --- Sign-in ---------------------------------------------------------------------------------------
# ADR-0014: organiser and competitor sign-in through the local API, no Microsoft account.
# Needs the API's LOCAL_SIGN_IN_ENABLED=true. Never true in a cluster build.
VITE_APP_LOCAL_SIGN_IN=true
# Organiser (workforce tenant); optional while local sign-in is on.
VITE_APP_MSAL_CLIENT_ID=
VITE_APP_MSAL_AUTHORITY=https://login.microsoftonline.com/common
VITE_APP_MSAL_API_SCOPE=
# Competitor sign-in: the external tenant's SPA registration (ADR-0012); blank until it exists.
VITE_APP_COMPETITOR_CLIENT_ID=
VITE_APP_COMPETITOR_AUTHORITY=
VITE_APP_COMPETITOR_SCOPE=

# --- Site content and analytics -------------------------------------------------------------------
VITE_APP_CF_BEACON_TOKEN=
VITE_APP_CONTACT_EMAIL=info@bjj-eire.com
VITE_APP_SOCIAL_INSTAGRAM_URL=
VITE_APP_SOCIAL_FACEBOOK_URL=
VITE_APP_GITHUB_URL=

# With the dev server on 5173, set STRIPE_SUCCESS_URL_BASE=http://localhost:5173 on the API so Stripe
# Checkout returns here (docs/stripe-local.md).
