# Template for the repository-root .env, read by Docker Compose for the local stack:
#   docker compose --profile app -f docker-compose.yml -f docker-compose.override.java-local.yml up --build --wait
# Copy to .env (gitignored) and fill in. Names and placeholders only: never commit a real value.
# VITE_APP_* values are frontend build arguments, baked into the image (ADR-0006): rebuild after changing one.

# --- MongoDB --------------------------------------------------------------------------------------
# MONGODB_PASSWORD must match secrets/mongodb_password.txt (the mongodb container reads that file).
MONGODB_USER=admin
MONGODB_PASSWORD=
MONGODB_PORT=27017
MONGODB_DB=Mongodb
# Seeder dataset: test (seeder/data-test/, includes BJJ Éire competitions) or empty for the production data.
SEED_DATASET=test

# --- Organiser sign-in (workforce Entra tenant) ----------------------------------------------------
# Optional locally while LOCAL_SIGN_IN_ENABLED=true. AZURE_AD_* are older fallbacks for ENTRA_*.
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_AUDIENCE=api://<api-client-id>
ENTRA_AUDIENCE_URI=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# --- Local sign-in for organiser and competitor (ADR-0014) -----------------------------------------
# Local development only: the API refuses to start with it on unless the 'local' profile is active.
LOCAL_SIGN_IN_ENABLED=true
# HS256 secret, 32 characters or more.
LOCAL_SIGN_IN_SECRET=

# --- Competitor tenant (Entra External ID, ADR-0012) ------------------------------------------------
# Not passed by the local override: application.yml placeholders apply and local sign-in stands in.
# Used by the base compose file once the tenant exists (T001).
COMPETITOR_ISSUER_URI=
COMPETITOR_AUDIENCE=
# Microsoft Graph credentials that delete a competitor's sign-in (research R11). Blank: logged, removed by hand.
COMPETITOR_DIRECTORY_TENANT_ID=
COMPETITOR_DIRECTORY_CLIENT_ID=
COMPETITOR_DIRECTORY_CLIENT_SECRET=

# --- API behaviour ---------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:3000
READ_ONLY_MODE_ENABLED=false
RATE_LIMIT_ENABLED=false
# The next three are read by the base compose file only; the local override turns rate limiting off.
RATE_LIMIT_PERMIT_LIMIT=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUSTED_PROXIES=
DONATION_BITCOIN_ADDRESS=REPLACE_WITH_OFFICIAL_ADDRESS

# --- Feature flags ---------------------------------------------------------------------------------
FEATURE_BJJEIRE_COMPETITIONS=true
FEATURE_GYMS=true
FEATURE_BJJ_EVENTS=true
FEATURE_COMPETITIONS=true
FEATURE_STORES=true
FEATURE_GYMS_MAP=true
FEATURE_EVENTS_MAP=true
# BJJ Éire merch (ADR-0016). Off until the shop's catalogue and checkout ship.
FEATURE_MERCH=false

# --- Stripe test mode (ADR-0013, docs/stripe-local.md) ----------------------------------------------
# While either secret is blank or contains REPLACE_ME, sign-up answers 502 and the webhook 503.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Printed by `stripe listen` (full command with --events in docs/stripe-local.md):
#   stripe listen --events checkout.session.completed,checkout.session.expired,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed \
#     --forward-to http://127.0.0.1:5003/api/v1/registration/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# The shop's own webhook endpoint (ADR-0016). A second `stripe listen` forwarding to
#   http://127.0.0.1:5003/api/v1/order/stripe-webhook prints its secret.
STRIPE_SHOP_WEBHOOK_SECRET=whsec_REPLACE_ME
# Where Checkout returns the competitor: the Docker SPA (3000) or the Vite dev server (5173).
STRIPE_SUCCESS_URL_BASE=http://localhost:3000

# --- Sign-up mail (research R6) -------------------------------------------------------------------
# The local override sends to Mailpit (UI http://127.0.0.1:8025) and ignores SPRING_MAIL_*.
# Outside it, a blank SPRING_MAIL_HOST means mail is logged, not sent.
MAIL_FROM=no-reply@bjjeire.local
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Observability (base compose only; the local override disables OpenTelemetry) -----------------
OTEL_SERVICE_NAME=bjjeire-api

# --- Frontend image build arguments (public, baked at build) -----------------------------------------
VITE_APP_APP_URL=http://localhost:3000
VITE_APP_LOCAL_SIGN_IN=true
# Organiser MSAL; optional while VITE_APP_LOCAL_SIGN_IN=true.
VITE_APP_MSAL_CLIENT_ID=
VITE_APP_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_APP_MSAL_API_SCOPE=api://<api-client-id>/access_as_writer
# Competitor MSAL (external tenant); blank until the tenant exists.
VITE_APP_COMPETITOR_CLIENT_ID=
VITE_APP_COMPETITOR_AUTHORITY=
VITE_APP_COMPETITOR_SCOPE=
VITE_APP_CF_BEACON_TOKEN=
