{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "/workspaces/bjjeire-tests",
      "/workspaces/bjjeire-terraform-azurerm-aks",
      "/workspaces/bjjeire-gitops",
      "/workspaces/bjjeire-deploy"
    ],
    "allow": [
      "Bash(npm --prefix src/bjjeire-app run lint)",
      "Bash(npm --prefix src/bjjeire-app run typecheck)",
      "Bash(npm --prefix src/bjjeire-app run test)",
      "Bash(npm --prefix src/bjjeire-app run test:*)",
      "Bash(npm --prefix src/bjjeire-app exec -- prettier --check *)",
      "Bash(mvn -pl src/bjjeire-api test*)",
      "Bash(mvn -pl src/bjjeire-api verify*)",
      "Bash(mvn -pl src/bjjeire-api spotless:apply)",
      "Bash(mvn -o -pl src/bjjeire-api *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git merge-base *)",
      "Bash(git ls-files*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.dev)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(//workspaces/bjjeire-tests/.env*)",
      "Read(//workspaces/bjjeire-tests/playwright/.auth/**)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/.env*)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/*.tfvars)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/*.tfstate*)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/.terraform/**)",
      "Read(//workspaces/bjjeire-gitops/.env*)",
      "Read(//workspaces/bjjeire-deploy/.env*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.mjs", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.mjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed.mjs",
            "timeout": 120,
            "statusMessage": "Formatting and linting the changed file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-changed.mjs", "timeout": 600 }
        ]
      }
    ]
  }
}
