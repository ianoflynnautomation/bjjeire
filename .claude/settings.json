{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "/workspaces/bjjeire-tests",
      "/workspaces/bjjeire-terraform-azurerm-aks",
      "/workspaces/bjjeire-gitops"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(//workspaces/bjjeire-tests/.env*)",
      "Read(//workspaces/bjjeire-tests/playwright/.auth/**)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/.env*)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/*.tfvars)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/*.tfstate*)",
      "Read(//workspaces/bjjeire-terraform-azurerm-aks/**/.terraform/**)",
      "Read(//workspaces/bjjeire-gitops/.env*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.mjs", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-changed.mjs", "timeout": 600 }
        ]
      }
    ]
  }
}
